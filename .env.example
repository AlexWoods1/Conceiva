MOTILITY_SERVICE_DEV=1
# * Defaults off on Vercel. Set true only with a reachable motility backend.
MOTILITY_UPLOADS_ENABLED=
# * Leave Stripe blank for a free demo (matches stay open).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
