LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
ENABLE_FACE_COMPARE=false
DATA_DIR=
DATABASE_PATH=
SEED_ON_EMPTY=true
CONTACT_EMAIL=privacy@example.com
APP_BASE_URL=http://127.0.0.1:8000
MOTILITY_SERVICE_URL=http://127.0.0.1:8010
